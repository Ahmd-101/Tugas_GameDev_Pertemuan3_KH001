import heapq

def get_neighbors(state):
    """Mencari semua kemungkinan gerakan cakram yang sah."""
    neighbors = []
    for i in range(3):
        if state[i]: # Jika tiang asal ada isinya
            disk = state[i][0]
            for j in range(3):
                # Jika tiang tujuan berbeda dan (kosong atau cakramnya lebih besar)
                if i != j and (not state[j] or state[j][0] > disk):
                    # Buat state baru
                    new_state = [list(tiang) for tiang in state]
                    new_state[i].pop(0)
                    new_state[j].insert(0, disk)
                    neighbors.append(tuple(tuple(tiang) for tiang in new_state))
    return neighbors

def best_first_search_sederhana(start, goal):
    # OPEN list dengan format: (nilai_heuristik, state_sekarang)
    open_list = [(0, start)] 
    visited = set([start])
    parent = {start: None}
    
    while open_list:
        # Mengambil node dengan nilai heuristik f(n) terkecil
        _, current = heapq.heappop(open_list)
        
        # Jika Goal tercapai, langsung susun rutenya dari parent
        if current == goal:
            path = []
            while current:
                path.append(current)
                current = parent[current]
            return path[::-1] # Balikkan dari Start -> Goal
            
        # Eksplorasi tetangga
        for next_state in get_neighbors(current):
            if next_state not in visited:
                visited.add(next_state)
                parent[next_state] = current
                
                # HEURISTIK f(n) = h(n)
                # Bobot = Jumlah nilai cakram yang BELUM ada di Tiang C (Target)
                # Semakin mendekati 0, semakin diprioritaskan
                # Jika cakram sudah di tiang C, maka nilainya tidak dihitung
                h = sum(next_state[0]) + sum(next_state[1])
                
                heapq.heappush(open_list, (h, next_state))
                
    return None


# JALANKAN PROGRAM

start_state = ((1, 2, 3), (), ())
goal_state = ((), (), (1, 2, 3))

path = best_first_search_sederhana(start_state, goal_state)

print("=== PENYELESAIAN HANOI (BEST-FIRST SEARCH SEDERHANA) ===")
for step, state in enumerate(path):
    print(f"Langkah {step}: A={state[0]}, B={state[1]}, C={state[2]}")
